# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# ============================================================================
# LLM Provider Configuration (Google Gemini)
# ============================================================================
# Get API key: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day
GOOGLE_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# ============================================================================
# Code Execution & Sandboxing (E2B)
# ============================================================================
# Get API key: https://e2b.dev
# Free tier: 100 compute hours/month
E2B_API_KEY="your_e2b_api_key_here"

# ============================================================================
# Observability & Tracing (LangSmith) - OPTIONAL
# ============================================================================
# Get API key: https://smith.langchain.com
# Free tier: 5,000 traces/month
# 
# Set to "true" to enable tracing
LANGCHAIN_TRACING_V2="true"

# Your LangSmith API key
LANGCHAIN_API_KEY="your_langsmith_api_key_here"

# Project name for organizing traces
LANGCHAIN_PROJECT="automaton-boardroom"

# ============================================================================
# Application Settings (Optional)
# ============================================================================

# Streamlit app settings
STREAMLIT_SERVER_PORT="8501"
STREAMLIT_SERVER_HEADLESS="false"

# Agent configuration
MAX_RETRIES="5"
TIMEOUT_SECONDS="300"
SANDBOX_RAM_MB="512"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

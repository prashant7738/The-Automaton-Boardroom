# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to version control!

# ============================================================================
# LLM Provider Configuration (OpenAI)
# ============================================================================
# Get API key: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-6-luna"
# Optional: request timeout (seconds) and SDK-level retries on 429/5xx
# OPENAI_TIMEOUT="300"
# OPENAI_MAX_RETRIES="3"

# Monthly spend limit per user (USD) when the server key is used. Default: 1.00
# MONTHLY_USER_LIMIT_USD="1.00"
# Prices per 1M tokens used to compute spend; set these to your model's real pricing.
# OPENAI_INPUT_PRICE_PER_1M="2.50"
# OPENAI_OUTPUT_PRICE_PER_1M="10.00"
# SQLite file that stores per-user monthly usage. Default: .usage/usage.db
# USAGE_DB_PATH=".usage/usage.db"

# ============================================================================
# Code Execution & Sandboxing (E2B)
# ============================================================================
# Get API key: https://e2b.dev
# Free tier: 100 compute hours/month
E2B_API_KEY="your_e2b_api_key_here"

# ============================================================================
# Observability & Tracing (LangSmith) - OPTIONAL
# ============================================================================
# Get API key: https://smith.langchain.com
# Free tier: 5,000 traces/month
# 
# Set to "true" to enable tracing
LANGCHAIN_TRACING_V2="true"

# Your LangSmith API key
LANGCHAIN_API_KEY="your_langsmith_api_key_here"

# Project name for organizing traces
LANGCHAIN_PROJECT="automaton-boardroom"

# ============================================================================
# Application Settings (Optional)
# ============================================================================

# Streamlit app settings
STREAMLIT_SERVER_PORT="8501"
STREAMLIT_SERVER_HEADLESS="false"

# Agent configuration
MAX_RETRIES="5"
TIMEOUT_SECONDS="300"
SANDBOX_RAM_MB="512"

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
